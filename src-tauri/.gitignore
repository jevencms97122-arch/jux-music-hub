# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Android release signing (never commit)
/gen/android/app/keystore.properties
/gen/android/app/*.keystore
/gen/android/app/*.jks

# Updater signing key (never commit)
/updater-private.key
/updater-private.key.pub
