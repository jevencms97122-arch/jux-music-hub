{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexora Music",
  "version": "0.0.5",
  "identifier": "fr.nexoramusic.jux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexora Music",
        "width": 1280,
        "height": 820,
        "minWidth": 400,
        "minHeight": 600,
        "backgroundColor": "#121212",
        "additionalBrowserArgs": "--disable-features=HardwareMediaKeyHandling,MediaSessionService"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/downloads/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/icon.ico": "icon.ico"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NzFGQzg2NEM0ODk2MEIKUldRTGxraE1odnh4aEZvYURWdVhJNmdVT09qY3pjZ0VvUjJzS0JEeXVJYkpUOEMyOVRJTU90MEsK",
      "endpoints": [
        "http://188.115.125.74:8085/api/jux-updater/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dangerousInsecureTransportProtocol": true
    }
  }
}
